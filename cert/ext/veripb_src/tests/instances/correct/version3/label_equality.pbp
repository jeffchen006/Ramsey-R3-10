pseudo-Boolean proof version 3.0
f 7 ;
% The first label names the `>=` direction of the equality and the second the `<=` direction.
e 1 x1 1 x2 >= 1 : @sum_lo ;
e 1 ~x1 1 ~x2 >= 1 : @sum_hi ;
e 1 x1 1 ~z1 1 x3 >= 1 : @reif_lo ;
e 1 ~x1 1 ~z1 1 ~x3 >= 1 : @reif_hi ;
e 1 ~z2 1 x1 >= 1 : @equiv_fwd ;
e 1 z2 1 ~x1 >= 1 : @equiv_rev ;
e 1 x1 >= 1 : @plain ;
output NONE;
conclusion NONE;
end pseudo-Boolean proof;
