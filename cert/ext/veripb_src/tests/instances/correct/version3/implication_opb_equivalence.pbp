pseudo-Boolean proof version 3.0
f 10 ;
% An equivalence is the same as the two single-sided shorthands written out.
e z1 ==> +1 x1 +2 x2 >= 2 : 1 ;
e z1 <== +1 x1 +2 x2 >= 2 : 2 ;
e 2 ~z1 1 x1 2 x2 >= 2 : 1 ;
e 2 z1 1 ~x1 2 ~x2 >= 2 : 2 ;
e 1 ~z2 1 ~x1 1 ~x2 >= 1 : 3 ;
e 2 z2 1 x1 1 x2 >= 2 : 4 ;
% `3 x1 2 ~x1 >= 3` is `1 x1 >= 1` once normalized.
e 1 z3 1 x1 >= 1 : 5 ;
e 1 ~z3 1 ~x1 >= 1 : 6 ;
% The degenerate cases keep the direction that does not depend on the literal free of it.
e 1 x1 >= 0 : 7 ;
e 2 z4 1 ~x1 >= 2 : 8 ;
e 5 ~z5 1 x1 >= 5 : 9 ;
e 1 ~x1 >= -3 : 10 ;
output NONE;
conclusion NONE;
end pseudo-Boolean proof;
