pseudo-Boolean proof version 3.0
% The plain equality on the first line counts as two constraints.
f 5 ;
% A reified inequality can be labelled, just like a plain inequality.
e 3 ~x1 2 ~x2 >= 1 : @leq ;
e z1 z2 ==> 1 x1 2 x2 >= 2 : @reif ;
e z3 <== 1 x1 2 x2 >= 2 : @back ;
% The labels map to the constraint IDs the labelled constraints were loaded with.
e 3 ~x1 2 ~x2 >= 1 : 3 ;
e 1 x1 2 x2 2 ~z1 2 ~z2 >= 2 : 4 ;
e 1 ~x1 2 ~x2 2 z3 >= 2 : 5 ;
output NONE;
conclusion NONE;
end pseudo-Boolean proof;
