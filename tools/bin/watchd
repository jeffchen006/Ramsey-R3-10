#!/usr/bin/python3
"""watchd: server-side watcher for the R(3,10) team; runs without the desktop app (owner: agent tools).

  watchd start            start in tmux (session "r310", window "watchd"); survives logout
  watchd stop             stop it (kills the tmux window)
  watchd status           running?, last heartbeat, last events, night-lead calls
  watchd once             one tick in the foreground (for tests)
  watchd mem              memory guard dry run: RSS per agent vs cap, kills nothing
  watchd run [--interval 60]   the loop itself (what `start` runs inside tmux)

Every tick (default 60 s), no LLM:
  1. `jobctl queue-run`: start queued follow-up jobs whose dependencies exited OK.
  0. Memory guard: per agent RSS (its jobctl job trees + this user's processes pinned to its CPUs);
     > cap -> MEMWARN (once per 6 h); > 1.5 x cap -> SIGKILL its biggest process groups/jobs until
     <= cap, MEMKILL event + mail to the agent and the lead. Unpinned processes are never killed.
  2. Job events of every agent (EXIT, CRASH, STOPPED, LOST, FAIL, DEADLINE, BLOCKED, FOUND*/ALERT*
     files under runs/AGENT/), same logic as `jobctl wait-event`, with its own state (agents'
     own wait-event calls are not affected). Each event: one line in runs/events.log and a mail
     to the owner (mbox, from "watchd").
  3. IDLE: an agent that had running or queued jobs now has none -> event + mail.
  4. Every new file in graphs/found/: `check_graph.py --k 10 --n 40 FILE`; result in events.log;
     PASS -> mail to all agents and the lead, file runs/watchd/VERIFIED_<name>; FAIL -> mail to lead.
  5. Night lead (optional, off unless runs/watchd/nightlead.on exists): on a MAJOR event (graph
     PASS, FOUND* file, FAIL, MEMKILL, CRASH/LOST of a job that ran >= 1 h and was not stopped
     by SIGTERM, IDLE of an agent not in NL_IGNORE_IDLE) run a headless
     `claude -p` with notes/NIGHT_LEAD.md, at most 6 calls per day (resets at midnight), one at a time, 30 min limit,
     tools limited to reading files and jobctl/mbox/teamstat/cuberun (no outside actions).
     Output: runs/watchd/nightlead/<time>.log.
State: runs/watchd/state.json (restart-safe), heartbeat, watchd.log. One instance (flock).
"""
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "lib"))
from r310common import ROOT, JOBS, agent_table, now_iso, read_json, write_json, fmt_dur  # noqa: E402
from r310common import my_procs, descendants, parse_cpulist, PAGE  # noqa: E402

_ld = importlib.machinery.SourceFileLoader("jobctl_mod", os.path.join(HERE, "jobctl"))
_spec = importlib.util.spec_from_loader("jobctl_mod", _ld)
jobctl = importlib.util.module_from_spec(_spec)
_ld.exec_module(jobctl)

WD = os.path.join(ROOT, "runs", "watchd")
EVENTS = os.path.join(ROOT, "runs", "events.log")
FOUND_DIR = os.path.join(ROOT, "graphs", "found")
CHECKER = os.path.join(ROOT, "tools", "check_graph.py")
MBOX = os.path.join(HERE, "mbox")
TMUX_SESSION, TMUX_WINDOW = "r310", "watchd"
CLAUDE_BINS = [os.path.expanduser("~/.local/bin/claude"),
               os.path.expanduser("~/.claude/remote/ccd-cli/2.1.308-3f6ee6c72f6a")]
NL_MAX_CALLS, NL_TIMEOUT = 6, 30 * 60  # max calls per day
TEST = os.environ.get("WATCHD_TEST_DIR")  # test mode: own state/events/found dir, all mail to "watchdtest"
if TEST:
    WD, EVENTS, FOUND_DIR = os.path.join(TEST, "wd"), os.path.join(TEST, "events.log"), os.path.join(TEST, "found")
NL_TOOLS = ["Read", "Grep", "Glob", "Bash(tools/bin/jobctl:*)", "Bash(tools/bin/mbox:*)",
            "Bash(tools/bin/teamstat:*)", "Bash(tools/bin/cuberun summary:*)", "Bash(tail:*)", "Bash(ls:*)",
            "Bash(grep:*)", "Bash(cat:*)", "Edit(notes/night_lead_log.md)"]
# IDLE of these agents does not wake the night lead: support agents, and live tmux teammates that wake
# by themselves (lead request 2026-10-25)
NL_IGNORE_IDLE = {"tools", "tlead", "sms", "cases", "duo", "critic", "gluing", "symsat"}
# the CLI's own login, not the desktop app's session (which is gone at night)
CLEAN_ENV = {k: os.environ[k] for k in ("HOME", "USER", "LOGNAME", "LANG", "SHELL") if k in os.environ}
CLEAN_ENV.update(PATH="/usr/local/bin:/usr/bin:/bin", TERM="dumb")


def log(msg):
    os.makedirs(WD, exist_ok=True)
    with open(os.path.join(WD, "watchd.log"), "a") as f:
        f.write("%s %s\n" % (now_iso(), msg))


def event(kind, msg, mail_to=None):
    with open(EVENTS, "a") as f:
        f.write("%s %s\n" % (now_iso(), msg))
    for to in ([mail_to] if isinstance(mail_to, str) else mail_to or []):
        to = "watchdtest" if TEST else to
        subprocess.run([sys.executable, MBOX, "send", to, msg, "--from", "watchd"], capture_output=True)


def agents_to_watch():
    names = set(agent_table())
    if os.path.isdir(JOBS):
        names |= set(os.listdir(JOBS))
    return sorted(names)


def busy_state(agent):
    running = any(jobctl.job_state(j)[0] == "running" for j in jobctl.load_jobs(agent))
    waiting = any(q.get("state") == "waiting" for q in jobctl.load_queue(agent))
    return running or waiting


def check_found(state, majors):
    seen = set(state.setdefault("found_checked", []))
    if not os.path.isdir(FOUND_DIR):
        return
    for f in sorted(os.listdir(FOUND_DIR)):
        p = os.path.join(FOUND_DIR, f)
        if f in seen or not os.path.isfile(p):
            continue
        seen.add(f)
        n = os.environ.get("WATCHD_TEST_N", "40") if TEST else "40"
        r = subprocess.run([sys.executable, CHECKER, "--k", "10", "--n", n, p], capture_output=True, text=True,
                           timeout=3600)
        last = (r.stdout.strip().splitlines() or [""])[-1]
        if r.returncode == 0:
            with open(os.path.join(WD, "VERIFIED_" + f), "w") as fh:
                fh.write(r.stdout)
            msg = "GRAPH-PASS graphs/found/%s passes check_graph --k 10 --n %s: %s" % (f, n, last)
            event("GRAPH-PASS", msg, ["all"])
            majors.append(msg)
        else:
            event("GRAPH-FAIL", "GRAPH-FAIL graphs/found/%s rc=%d: %s" % (f, r.returncode, last), ["lead"])
    state["found_checked"] = sorted(seen)


MEM_KILL_FACTOR, MEM_WARN_EVERY = 1.5, 6 * 3600


def mem_guard(state, majors):
    """Per agent RSS (its jobctl job trees + this user's processes pinned to its CPUs).
    > cap: WARN (once per 6 h); > 1.5 x cap: SIGKILL its biggest process groups until <= cap."""
    import signal
    table = agent_table()
    only = os.environ.get("WATCHD_TEST_AGENTS")  # tests: guard only these agents, with a fake cap
    if only:
        table = {a: dict(table[a], mem_gb=float(os.environ.get("WATCHD_TEST_CAP_GB", table[a]["mem_gb"])))
                 for a in only.split(",")}
    dry = os.environ.get("WATCHD_MEM_DRYRUN")
    procs = my_procs()
    me = set(descendants(os.getpid(), procs))
    owner, unit = {}, {}  # pid -> agent, pid -> kill unit
    jobs_by_unit = {}
    for agent in table:
        for j in jobctl.load_jobs(agent):
            if jobctl.job_state(j)[0] != "running" or not j.get("supervisor_pid"):
                continue
            for pid in descendants(j["supervisor_pid"], procs):
                if pid != j["supervisor_pid"]:
                    owner[pid], unit[pid] = agent, "job:%s/%s" % (agent, j["name"])
            jobs_by_unit["job:%s/%s" % (agent, j["name"])] = j
    cpusets = {a: set(i["cpus"]) for a, i in table.items() if i["cpus"] and not i["shared"]}
    for pid, st in procs.items():
        if pid in owner or pid in me or not st[4]:
            continue
        aff = set(parse_cpulist(st[4]))
        cands = [a for a, cs in cpusets.items() if aff and aff <= cs]
        if cands:  # several agents share these CPUs: count it for the one with the largest cap
            owner[pid] = max(cands, key=lambda a: table[a]["mem_gb"])
            unit[pid] = "pgid:%d" % st[0]
    rss = {}
    urss = {}
    for pid, a in owner.items():
        b = procs[pid][3] * PAGE
        rss[a] = rss.get(a, 0) + b
        urss[(a, unit[pid])] = urss.get((a, unit[pid]), 0) + b
    warned = state.setdefault("mem_warned", {})
    for a, total in sorted(rss.items()):
        cap = table[a]["mem_gb"] * 2 ** 30
        if dry:
            print("%-8s rss %7.1f GB  cap %5g GB  %s" % (a, total / 2 ** 30, table[a]["mem_gb"],
                  "KILL" if total > MEM_KILL_FACTOR * cap else "warn" if total > cap else "ok"))
            continue
        if total > MEM_KILL_FACTOR * cap:
            units = sorted(((b, u) for (aa, u), b in urss.items() if aa == a), reverse=True)
            killed, left = [], total
            for b, u in units:
                if left <= cap:
                    break
                pids = [p for p, uu in unit.items() if uu == u and owner[p] == a]
                if u in jobs_by_unit:
                    j = jobs_by_unit[u]
                    j["memkill"] = "watchd: %s RSS %.1f GB > %.1f x cap %g GB" % (
                        a, total / 2 ** 30, MEM_KILL_FACTOR, table[a]["mem_gb"])
                    write_json(jobctl.jobfile(a, j["name"]), j)
                for p in pids:
                    try:
                        os.kill(p, signal.SIGKILL)
                    except OSError:
                        pass
                killed.append("%s (%.1f GB, %d procs)" % (u, b / 2 ** 30, len(pids)))
                left -= b
            msg = "MEMKILL %s: RSS %.1f GB > %.1f x cap %g GB; killed %s" % (
                a, total / 2 ** 30, MEM_KILL_FACTOR, table[a]["mem_gb"], "; ".join(killed))
            event("MEMKILL", msg, [a, "lead"])
            majors.append(msg)
        elif total > cap and time.time() - warned.get(a, 0) > MEM_WARN_EVERY:
            warned[a] = time.time()
            event("MEMWARN", "MEMWARN %s: RSS %.1f GB > cap %g GB (kill at %.1f x)" % (
                a, total / 2 ** 30, table[a]["mem_gb"], MEM_KILL_FACTOR), [a])


def tick(state):
    majors = []
    mem_guard(state, majors)
    r = subprocess.run([sys.executable, os.path.join(HERE, "jobctl"), "queue-run"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        a = line.split()[1].split("/")[0] if len(line.split()) > 1 else "lead"
        event("QUEUE", "QUEUE " + line, [a])
    seen_all = state.setdefault("seen", {})
    busy = state.setdefault("busy", {})
    for agent in agents_to_watch():
        seen = seen_all.setdefault(agent, {})
        for kind, msg, j in jobctl.collect_events(agent, seen):
            if "graphs/found/" in msg:
                continue  # handled by check_found
            event(kind, msg, [agent])
            if kind in ("FOUND", "FAIL", "MEMKILL"):
                majors.append(msg)
            if kind in ("CRASH", "LOST") and j is not None:
                ex = read_json(jobctl.exitfile(agent, j["name"])) or {}
                stopped_by_hand = ex.get("rc") in (-15, 143)  # SIGTERM: someone stopped it, not a crash
                if not stopped_by_hand and ex.get("runtime_s", time.time() - j.get("start_ts", time.time())) >= 3600:
                    majors.append(msg)
        now_busy = busy_state(agent)
        if busy.get(agent) and not now_busy:
            msg = "IDLE %s: no running and no queued jobs" % agent
            event("IDLE", msg, [agent])
            if agent not in NL_IGNORE_IDLE:
                majors.append(msg)
        busy[agent] = now_busy
    check_found(state, majors)
    nightlead_done(state)
    if majors:
        night_lead(state, majors)
    with open(os.path.join(WD, "heartbeat"), "w") as f:
        f.write(now_iso() + "\n")


def nightlead_done(state):
    """True if no night-lead call is running; on its end, log it and detect the usage-limit message."""
    nl = state.get("nightlead") or {}
    if not nl.get("pid"):
        return True
    try:  # reap our own child (else it stays a zombie and looks alive)
        os.waitpid(nl["pid"], os.WNOHANG)
    except ChildProcessError:
        pass
    if jobctl.pid_alive(nl["pid"]):
        return False
    out = open(nl["out"]).read() if os.path.exists(nl.get("out", "")) else ""
    if "hit your" in out and "limit" in out:
        nl["limit_until"] = time.time() + 6 * 3600
        event("NIGHTLEAD", "NIGHTLEAD usage limit reached, no calls for 6 h: %s" % out.strip().splitlines()[-1][:120],
              ["lead"])
    else:
        event("NIGHTLEAD", "NIGHTLEAD call ended, log %s" % os.path.relpath(nl["out"], ROOT), ["lead"])
    nl["pid"] = None
    return True


def calls_today(nl):
    """Night-lead calls since local midnight (the counter resets daily)."""
    today = time.strftime("%Y-%m-%d")
    return sum(1 for t in nl.get("calls", []) if time.strftime("%Y-%m-%d", time.localtime(t)) == today)


def night_lead(state, majors):
    nl = state.setdefault("nightlead", {"calls": [], "pid": None, "limit_until": 0})
    pending = nl.setdefault("pending", [])
    pending.extend(majors)
    if not os.path.exists(os.path.join(WD, "nightlead.on")):
        nl["pending"] = []
        return
    if not nightlead_done(state):
        return  # one call at a time; events stay pending
    now = time.time()
    nl["calls"] = [t for t in nl["calls"] if now - t < 2 * 86400]
    if now < nl.get("limit_until", 0) or calls_today(nl) >= NL_MAX_CALLS:
        return
    binp = next((b for b in CLAUDE_BINS if os.path.exists(b)), None)
    if not binp:
        return
    os.makedirs(os.path.join(WD, "nightlead"), exist_ok=True)
    out = os.path.join(WD, "nightlead", time.strftime("%Y%m%d-%H%M%S") + ".log")
    prompt = ("You are the night lead of the R(3,10) team. Follow notes/NIGHT_LEAD.md exactly. "
              "Major events since the last call:\n- " + "\n- ".join(pending[-20:]))
    with open(out, "w") as f:
        f.write("[watchd] events:\n- %s\n\n" % "\n- ".join(pending[-20:]))
        f.flush()
        p = subprocess.Popen(["timeout", str(NL_TIMEOUT), binp, "-p", prompt, "--allowedTools"] + NL_TOOLS + [
                              "--max-turns", "40"], cwd=ROOT, stdin=subprocess.DEVNULL, stdout=f, env=CLEAN_ENV,
                             stderr=subprocess.STDOUT, start_new_session=True)
    nl.update(pid=p.pid, out=out, pending=[])
    nl["calls"].append(now)
    event("NIGHTLEAD", "NIGHTLEAD call %d/%d today started, log %s" % (calls_today(nl), NL_MAX_CALLS,
                                                              os.path.relpath(out, ROOT)), ["lead"])


def run(interval):
    os.makedirs(WD, exist_ok=True)
    lockf = open(os.path.join(WD, ".lock"), "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("watchd: another instance is running")
    sf = os.path.join(WD, "state.json")
    state = read_json(sf, {})
    if not state:  # first start: existing events and files are not news
        for agent in agents_to_watch():
            jobctl.collect_events(agent, state.setdefault("seen", {}).setdefault(agent, {}))
        state["found_checked"] = []  # but check every existing found graph once
    write_json(os.path.join(WD, "pid.json"), {"pid": os.getpid(), "start": now_iso()})
    log("started pid %d interval %ds" % (os.getpid(), interval))
    while True:
        t0 = time.time()
        try:
            tick(state)
        except Exception as e:  # keep running; log the problem
            log("tick error: %r" % (e,))
        write_json(sf, state)
        if interval <= 0:
            return
        time.sleep(max(1, interval - (time.time() - t0)))


def tmux(*args):
    return subprocess.run(["tmux"] + list(args), capture_output=True, text=True)


def status():
    hb = os.path.join(WD, "heartbeat")
    age = time.time() - os.path.getmtime(hb) if os.path.exists(hb) else None
    lockf = open(os.path.join(WD, ".lock"), "w") if os.path.isdir(WD) else None
    running = False
    if lockf:
        try:
            fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            running = True
    pid = (read_json(os.path.join(WD, "pid.json")) or {}).get("pid")
    print("watchd: %s (pid %s), last heartbeat %s" % ("RUNNING" if running else "NOT RUNNING", pid,
          fmt_dur(age) + " ago" if age is not None else "never"))
    st = read_json(os.path.join(WD, "state.json"), {})
    nl = st.get("nightlead", {})
    print("night lead: %s; calls today: %d/%d" % (
        "ON" if os.path.exists(os.path.join(WD, "nightlead.on")) else "OFF (touch runs/watchd/nightlead.on)",
        calls_today(nl), NL_MAX_CALLS))
    if os.path.exists(EVENTS):
        lines = open(EVENTS).read().splitlines()[-5:]
        print("last events:\n  " + "\n  ".join(lines))
    return 0 if running else 1


def main():
    a = sys.argv[1:]
    if a[:1] == ["mem"]:  # dry run of the memory guard: print RSS per agent, kill nothing
        os.environ["WATCHD_MEM_DRYRUN"] = "1"
        mem_guard({}, [])
        return 0
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if a[0] == "run":
        run(int(a[a.index("--interval") + 1]) if "--interval" in a else 60)
    elif a[0] == "once":
        run(0)
    elif a[0] == "start":
        cmd = "exec %s %s run >> %s 2>&1" % (sys.executable, os.path.realpath(__file__),
                                            os.path.join(WD, "watchd.out"))
        os.makedirs(WD, exist_ok=True)
        if tmux("has-session", "-t", TMUX_SESSION).returncode == 0:
            r = tmux("new-window", "-d", "-t", TMUX_SESSION, "-n", TMUX_WINDOW, cmd)
        else:
            r = tmux("new-session", "-d", "-s", TMUX_SESSION, "-n", TMUX_WINDOW, cmd)
        if r.returncode:
            sys.exit("tmux failed: " + r.stderr)
        time.sleep(3)
        return status()
    elif a[0] == "stop":
        r = tmux("kill-window", "-t", "%s:%s" % (TMUX_SESSION, TMUX_WINDOW))
        print("stopped" if r.returncode == 0 else "no watchd window: " + r.stderr.strip())
    elif a[0] == "status":
        return status()
    else:
        sys.exit("unknown command %s" % a[0])
    return 0


if __name__ == "__main__":
    sys.exit(main())
