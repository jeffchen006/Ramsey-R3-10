    7: {7: 1, 8: 2, 9: 3, 10: 4, 11: 5, 12: 6, 13: 9, 14: 12, 15: 15, 16: 20, 17: 25, 18: 30, 19: 37, 20: 44, 21: 51, 22: 60, 23: None},
    8: {8: 1, 9: 2, 10: 3, 11: 4, 12: 5, 13: 6, 14: 7, 15: 10, 16: 13, 17: 16, 18: 20, 19: 25, 20: 30, 21: 35, 22: 42, 23: 49, 24: 56, 25: 65, 26: 73, 27: 85, 28: None},
    9: {9: 1, 10: 2, 11: 3, 12: 4, 13: 5, 14: 6, 15: 7, 16: 8, 17: 11, 18: 14, 19: 17, 20: 20, 21: 25, 22: 30, 23: 35, 24: 40, 25: 46, 26: 52, 27: 61, 28: 68, 29: 77, 30: 86, 31: 95, 32: 104, 33: 118, 34: 129, 35: 140, 36: None},
}


def e3(k, n):
    """e(3,k,n); 0 for n < k; None if n >= R(3,k)."""
    if n < k:
        return 0
    return E[k][n]

