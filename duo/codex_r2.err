import runpy,sys,networkx as nx,numpy as np
from math import comb
from scipy.optimize import linprog
sys.path.insert(0,'cases'); mod=runpy.run_path('cases/b2_profile_lp.py',run_name='readonly')
idx={('I',s):s-1 for s in range(1,11)}
for s in range(1,10):
 for m in range(41):
  if mod['ebounds'](s,m) is not None:idx['p',s,m]=len(idx)
b=len(idx);types=[]
def poly(H):
 n=len(H);adj=[sum(1<<j for j in H[i]) for i in H];out=[0]*6
 def rec(can,k):
  out[k]+=1
  while can:
   bit=can&-can;can"'^=bit;v=bit.bit_length()-1;rec(can&~adj[v],k+1)
 rec((1<<n)-1,0);return out
for n in range(14):
 for line in open('"'gluing/val/r3_5_%d.g6'%n):
  line=line.strip()
  if line and not line.startswith('>>'):types.append((n,poly(nx.from_graph6_bytes(line.encode()))))
# Capture the base LP, without writing any file.
saved={}
def capture(c,**kw):
 saved.update(kw)
 return linprog(c,**kw)
mod['main'].__globals__['linprog']=capture
import contextlib,io
with contextlib.redirect_stdout(io.StringIO()):mod['main']()
for M in range(3,8):
 for caps in (False,True):
  q=len(types);N=b+q+7; eq=list(np.pad(saved['A_eq'],((0,0),(0,N-b))));be=list(saved['b_eq']);ub=list(np.pad(saved['A_ub'],((0,0),(0,N-b))));bu=list(saved['b_ub']);bd=saved['bounds']+[(0,None)]*(N-b)
  def row():return np.zeros(N)
  def e(r,v=0):eq.append(r);be.append(v)
  def u(r,v=0):ub.append(r);bu.append(v)
  for m in range(14):
   r=row();r[idx['p',5,m]]=-1
   for j,(n,p) in enumerate(types):
    if n==m:r[b+j]=1
   e(r)
  for t in range(1,5):
   r=row();r[idx['I',5+t]]=-comb(5+t,t)
   for j,(n,p) in enumerate(types):r[b+j]=p[t]
   e(r)
  # Pair variables G_c; n_c is p[2][20+c].
  for m in range(41):
   if ('p',2,m) in idx and not 21<=m<=20+M:bd[idx['p',2,m]]=(0,0)
  c4=row();c4[idx['I',4]]=1
  for c in range(1,8):c4[idx['p',2,20+c]]=-comb(c,2)/2
  e(c4,17920)
  r=row();r[idx['I',4]]=4;r[b+q:]=1;e(r,11520+4*17920)
  for c in range(1,8):
   ni=idx['p',2,20+c];gi=b+q+c-1
   lo=max(9-c,mod['e3'](8,20+c)-18-9*c)
   hi=min((9-c)**2,M*(9-c))
   r=row();r[ni]=lo;r[gi]=-1;u(r)
   r=row();r[ni]=-hi;r[gi]=1;u(r)
  bd[idx['p',2,21]]=(0,160)
  r=row();r[idx['p',8,2]]=-1;r[idx['p',2,21]]=2;u(r)
  r=row();r[idx['p',8,1]]=-1;r[idx['p',2,21]]=-2;u(r,-360)
  if caps:
   for s,cap in [(3,22),(4,17),(5,13),(6,8)]:
    for m in range(cap,41):
     if ('p',s,m) in idx:bd[idx['p',s,m]]=(0,0)
   for j,(n,p) in enumerate(types):
    if n==13:bd[b+j]=(0,0)
  obj=row();obj[idx['I',9]]=1
  ans=linprog(obj,A_ub=np.array(ub),b_ub=bu,A_eq=np.array(eq),b_eq=be,bounds=bd,method='highs')
  print('cmax',M,'forbid_tight',caps,'status',ans.status,'I9min',ans.fun,flush=True)
