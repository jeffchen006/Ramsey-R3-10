"""Hybrid test 2: fix X = G - N[u] - N[w] (u, w non-adjacent) in R(3,8;27), i.e. |X| = 27,
and let SAT find the other 13 vertices (u, w, Y = N(u) | N(w), |Y| = 11) of a (3,10;40)-graph.
No degree or regularity assumption beyond Delta <= 9.

vars: au[y], aw[y] (y ~ u, y ~ w), with au|aw for all y (every y is in N(u) | N(w));
      e[y][y'] (11*10/2), f[y][x] (11*27).
constraints: triangle-free; Delta <= 9 (seq counters); alpha <= 9 lazily (CEGAR: independent
10-set found in a model -> clause "one of its variable pairs is an edge");
symmetry: rows of Y lex-ordered (Y vertices are interchangeable).
usage: python3 satx.py X.g6 [max] [skip]
"""
import sys, time, itertools
from pysat.solvers import Cadical153
from pysat.card import CardEnc, EncType
from pysat.formula import IDPool

sys.setrecursionlimit(10000)

def g6dec(s):
    n = ord(s[0]) - 63; bits = []
    for ch in s[1:]:
        x = ord(ch) - 63; bits += [(x >> (5 - t)) & 1 for t in range(6)]
    adj = [0] * n; k = 0
    for j in range(1, n):
        for i in range(j):
            if bits[k]: adj[i] |= 1 << j; adj[j] |= 1 << i
            k += 1
    return n, adj

def find_indep(adj, m, k):
    if k <= 0: return 0
    if bin(m).count('1') < k: return None
    best, bd = -1, -1; t = m
    while t:
        v = (t & -t).bit_length() - 1; t &= t - 1
        d = bin(adj[v] & m).count('1')
        if d > bd: bd, best = d, v
    if bd == 0:
        r = 0; t = m
        for _ in range(k):
            v = (t & -t).bit_length() - 1; t &= t - 1; r |= 1 << v
        return r
    r = find_indep(adj, m & ~adj[best] & ~(1 << best), k - 1)
    if r is not None: return r | (1 << best)
    return find_indep(adj, m & ~(1 << best), k)

def all_indep(adj, m, k, cur, out, cap):
    if len(out) >= cap: return
    if k == 0:
        out.append(cur); return
    if bin(m).count('1') < k: return
    v = (m & -m).bit_length() - 1
    all_indep(adj, m & ~adj[v] & ~(1 << v), k - 1, cur | (1 << v), out, cap)
    all_indep(adj, m & ~(1 << v), k, cur, out, cap)

CAP = int(__import__('os').environ.get('SATX_CAP', '200'))

def solve(s):
    nX, xadj = g6dec(s)
    NY = 11
    # vertex ids in G: X = 0..26, Y = 27..37, u = 38, w = 39
    Y = list(range(nX, nX + NY)); U, Wv = nX + NY, nX + NY + 1
    pool = IDPool()
    var = {}
    def ev(a, b):
        if a > b: a, b = b, a
        return var.setdefault((a, b), pool.id((a, b)))
    S = Cadical153()
    for y in Y:
        S.add_clause([ev(y, U), ev(y, Wv)])
    # triangle-free
    for y in Y:
        for x in range(nX):
            for x2 in range(x + 1, nX):
                if xadj[x] >> x2 & 1:
                    S.add_clause([-ev(y, x), -ev(y, x2)])
        for y2 in Y:
            if y2 <= y: continue
            for x in range(nX):
                S.add_clause([-ev(y, y2), -ev(y, x), -ev(y2, x)])
            for z in (U, Wv):
                S.add_clause([-ev(y, y2), -ev(y, z), -ev(y2, z)])
            for y3 in Y:
                if y3 <= y2: continue
                S.add_clause([-ev(y, y2), -ev(y, y3), -ev(y2, y3)])
    # degrees <= 9
    def atmost(lits, b):
        if b < 0:
            S.add_clause([]); return
        if len(lits) <= b: return
        for c in CardEnc.atmost(lits=lits, bound=b, vpool=pool, encoding=EncType.seqcounter).clauses:
            S.add_clause(c)
    atmost([ev(y, U) for y in Y], 9)
    atmost([ev(y, Wv) for y in Y], 9)
    for y in Y:
        atmost([ev(y, z) for z in list(range(nX)) + [q for q in Y if q != y] + [U, Wv]], 9)
    for x in range(nX):
        atmost([ev(y, x) for y in Y], 9 - bin(xadj[x]).count('1'))
    # lex order of Y rows: row(y) = [au, aw, f[y][0..26]] (edges among Y excluded for simplicity)
    rows = [[ev(y, U), ev(y, Wv)] + [ev(y, x) for x in range(nX)] for y in Y]
/* mcount.c - Monte Carlo estimate of edge-count ratios g(e+1)/g(e) for
 * labelled (3,K;n,e)-graphs (triangle-free, alpha < K), K given as -k.
 *
 * Chain: states = valid labelled graphs with elo <= e <= ehi.
 * Moves: toggle a random pair (add/remove one edge), or swap (remove random edge,
 * add random non-edge). Acceptance min(1, w(e')/w(e)), w = exp(-lng) learned by
 * Wang-Landau, then fixed for the production phase.
 * Estimator (broad histogram / transition matrix):
 *   g(e) * <a>_e = g(e+1) * <r>_{e+1}
 * a(G) = #non-edges that can be added (no triangle), r(G) = #edges that can be
 * removed (alpha stays < K). Within a level the chain is uniform, so these
 * level averages are unbiased.
 *
 * usage: mcount -n N -k K -l ELO -h EHI -s SEED -w WLSTEPS -p PRODSTEPS < start.g6
 * start graph: any (3,K;N)-graph; the chain first walks into [ELO,EHI].
 */
#include "gutil.h"
#include <math.h>
#include <getopt.h>
#include <time.h>

static int n, K, elo, ehi;
static set_t adj[64];
static int ne;                  /* current edges */
static uint64_t rng_s[2];
static inline uint64_t rnd(void)
{   /* xorshift128+ */
    uint64_t s1 = rng_s[0], s0 = rng_s[1];
    rng_s[0] = s0; s1 ^= s1 << 23;
    rng_s[1] = s1 ^ s0 ^ (s1 >> 17) ^ (s0 >> 26);
    return rng_s[1] + s0;
}
static inline int rndint(int m) { return (int)((rnd() >> 11) % (uint64_t)m); }
static inline double rnd01(void) { return (rnd() >> 11) * (1.0 / 9007199254740992.0); }

/* edge and non-edge lists with index maps */
static int P;                   /* number of pairs */
static int pu[2048], pv[2048];  /* pair id -> endpoints */
static int pid[64][64];
static int elist[2048], epos[2048], nel;  /* edges */
static int flist[2048], fpos[2048], nfl;  /* non-edges */

static void lists_build(void)
{
    nel = nfl = 0;
    for (int p = 0; p < P; p++) {
        if (adj[pu[p]] & BIT(pv[p])) { epos[p] = nel; elist[nel++] = p; }
        else { fpos[p] = nfl; flist[nfl++] = p; }
    }
    ne = nel;
}
static void move_to_edges(int p)
{
    int i = fpos[p], q = flist[--nfl]; flist[i] = q; fpos[q] = i;
    epos[p] = nel; elist[nel++] = p;
}
static void move_to_nonedges(int p)
{
    int i = epos[p], q = elist[--nel]; elist[i] = q; epos[q] = i;
    fpos[p] = nfl; flist[nfl++] = p;
}

static set_t ALL;
/* after removing edge u-v: is there an independent K-set? (must contain u and v) */
static inline int removal_bad(int u, int v)
{
    set_t m = ALL & ~adj[u] & ~adj[v] & ~BIT(u) & ~BIT(v);
    return has_indep(adj, m, K - 2);
}

static int count_a(void)
{
    int a = 0;
    for (int i = 0; i < nfl; i++) { int p = flist[i]; if (!(adj[pu[p]] & adj[pv[p]])) a++; }
    return a;
}
static int count_r(void)
{
    int r = 0;
    for (int i = 0; i < nel; i++) {
        int p = elist[i], u = pu[p], v = pv[p];
        adj[u] &= ~BIT(v); adj[v] &= ~BIT(u);
        if (!removal_bad(u, v)) r++;
        adj[u] |= BIT(v); adj[v] |= BIT(u);
    }
    return r;
}

#define MAXL 400
static double lng[MAXL];       /* indexed by e */
static double H[MAXL];
static double sa[MAXL], sr[MAXL], sa2[MAXL], sr2[MAXL]; static long long ns[MAXL];

/* one Metropolis step; returns 1 if state changed */
static long long acc_t, acc_s, try_t, try_s;
static int step(void)
{
    if (rnd() & 1) {
        /* toggle */
        int p = rndint(P), u = pu[p], v = pv[p];
        try_t++;
        if (adj[u] & BIT(v)) {
            int e2 = ne - 1;
            if (e2 < elo) return 0;
            double d = lng[ne] - lng[e2];
            if (d < 0 && rnd01() >= exp(d)) return 0;
            adj[u] &= ~BIT(v); adj[v] &= ~BIT(u);
            if (removal_bad(u, v)) { adj[u] |= BIT(v); adj[v] |= BIT(u); return 0; }
            move_to_nonedges(p); ne--; acc_t++; return 1;
        } else {
            int e2 = ne + 1;
            if (e2 > ehi) return 0;
            if (adj[u] & adj[v]) return 0;
            double d = lng[ne] - lng[e2];
            if (d < 0 && rnd01() >= exp(d)) return 0;
            adj[u] |= BIT(v); adj[v] |= BIT(u);
            move_to_edges(p); ne++; acc_t++; return 1;
        }
    } else {
        /* swap: remove edge p, add non-edge q */
        if (nel == 0 || nfl == 0) return 0;
        try_s++;
        int p = elist[rndint(nel)], q = flist[rndint(nfl)];
        int a = pu[p], b = pv[p], c = pu[q], d = pv[q];
        adj[a] &= ~BIT(b); adj[b] &= ~BIT(a);
        if (adj[c] & adj[d]) { adj[a] |= BIT(b); adj[b] |= BIT(a); return 0; }
        adj[c] |= BIT(d); adj[d] |= BIT(c);
        if (removal_bad(a, b)) {
            adj[c] &= ~BIT(d); adj[d] &= ~BIT(c);
            adj[a] |= BIT(b); adj[b] |= BIT(a); return 0;
        }
        move_to_nonedges(p); move_to_edges(q); acc_s++; return 1;
    }
}

int main(int argc, char **argv)
{
    long long wlsteps = 100000000, prodsteps = 100000000;
    uint64_t seed = 1;
    int sampint = 0, c;
