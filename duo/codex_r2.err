import networkx as nx
G=nx.from_graph6_bytes(open('data/graphs/mckay/r39_35.g6').readline().strip().encode())
# Use an independent four-set, so the induced 31-vertex graph has 108 edges.
D=next(S for S in __import__('itertools').combinations(G,4) if not any(G.has_edge(u,v) for i,u in enumerate(S) for v in S[i+1:]))
K=G.subgraph(set(G)-set(D)).copy();z=next(v for v in K if K.degree(v)==8)
V=sorted(K);adj={v:set(K[v]) for v in K}
def has(can,k):
 if k<=0:return True
 if len(can)<k:return False
 while len(can)>=k:
  v=min(can);can=can-{v}
  if has(can-adj[v],k-1):return True
 return False
for a,b in list(K.edges()):
 if z in (a,b):continue
 adj[a].remove(b);adj[b].remove(a)
 # Any new independent nine-set must contain both a,b.
 if not has(set(K)-adj[a]-adj[b]-{a,b},7):
