import networkx as nx,numpy as np
from scipy.optimize import linprog, milp,LinearConstraint,Bounds
from itertools import islice
for index,line in enumerate(islice(open('gluing/samp30_99.g6'),12)):
 H=nx.from_graph6_bytes(line.strip().encode());n=len(H);adj=[sum(1<<j for j in H[v]) for v in H];sets=[]
 def rec(can,cur,k):
  if k==8:sets.append(cur);return
  while can.bit_count()>=8-k:
   bit=can&-can;can"'^=bit;v=bit.bit_length()-1;rec(can&~adj[v],cur|bit,k+1)
 rec((1<<n)-1,0,0)
 q=len(sets);M=np.array([[(S>>v)&1 for S in sets] for v in range(n)]+[[1]*q],dtype=float);need=np.array([9-H.degree(v) for v in H]+[9]);D=np.array([[int(not(S&T)) for S in sets] for T in sets],dtype=float)
 r=linprog(np.zeros(q),A_eq=M,b_eq=need,A_ub=D,b_ub=np.ones(q),bounds=(0,1),method='"'highs')
 print(index,'I8',q,'pair_packing_LP',r.status,flush=True)
 if r.status==0:
  z=milp(np.zeros(q),integrality=np.ones(q),bounds=Bounds(0,1),constraints=[LinearConstraint(M,need,need),LinearConstraint(D,0,1)],options={'time_limit':2})
  print('integer_status',z.status,'selected',None if z.x is None else round(sum(z.x)),flush=True)
