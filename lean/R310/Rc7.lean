/-
The R(7) case formula (cert: lean/out/cube_R.opb + runs/cert/base40/Rc7b/case.opb, generated by
cert/base40_cert.py with --codeg-max 7 --codeg-pair 7 --edges 10-11,10-12,8-11,8-12,9-11,9-12
--block-from 13 --block-e 85) as a graph property `PRc7`, and its invariance under the block
group of `blocks=1:7,2,1,2,27` (hypothesis `hinv` of `Gen.lexleader_inv`).
-/
import R310.GenLex
import R310.LexLeader

open Finset

set_option linter.unusedSectionVars false

namespace R310.Rc7

open R310 R310.Files R310.Gen SimpleGraph

/-- Block sizes `{0}, {1..7}, {8,9}, {10}, {11,12}, {13..39}`. -/
def blk7 : List ℕ := [1, 7, 2, 1, 2, 27]

/-- Explicit block index. -/
def bidx (v : ℕ) : ℕ :=
  if v = 0 then 0 else if v ≤ 7 then 1 else if v ≤ 9 then 2 else if v = 10 then 3
  else if v ≤ 12 then 4 else 5

theorem blockOf_blk7 : ∀ v < 40, blockOf blk7 v = bidx v := by decide

/-- Edges with both ends in `{13..39}`. -/
def blockEdges (G : SimpleGraph (Fin 40)) [DecidableRel G.Adj] : ℕ :=
  #{e ∈ G.edgeFinset | ∀ x ∈ e, 13 ≤ x.val}

/-- The R(7) case formula. -/
structure PRc7 (G : SimpleGraph (Fin 40)) [DecidableRel G.Adj] : Prop where
  tri : G.CliqueFree 3
  alpha : G.indepNum ≤ 9
  cube : CubeR G
  e1 : G.Adj 10 11
  e2 : G.Adj 10 12
  e3 : G.Adj 8 11
  e4 : G.Adj 8 12
  e5 : G.Adj 9 11
  e6 : G.Adj 9 12
  pair : ∀ i : Fin 40, 1 ≤ i.val → i.val ≤ 9 → (G.Adj 10 i ↔ i.val ≤ 7)
  codeg : ∀ u v : Fin 40, u ≠ v → #(G.neighborFinset u ∩ G.neighborFinset v) ≤ 7
  blockE : blockEdges G = 85

theorem bidx_spec {v w : ℕ} (h : bidx v = bidx w) :
    (v = 0 ↔ w = 0) ∧ (1 ≤ v ∧ v ≤ 7 ↔ 1 ≤ w ∧ w ≤ 7) ∧ (8 ≤ v ∧ v ≤ 9 ↔ 8 ≤ w ∧ w ≤ 9) ∧
      (v = 10 ↔ w = 10) ∧ (11 ≤ v ∧ v ≤ 12 ↔ 11 ≤ w ∧ w ≤ 12) ∧ (13 ≤ v ↔ 13 ≤ w) := by
  unfold bidx at h; split_ifs at h <;> omega

/-- **`hinv` for the R(7) case formula**: `PRc7` is invariant under every permutation that maps
each block of `1:7,2,1,2,27` onto itself. -/
theorem prc7_inv (G : SimpleGraph (Fin 40)) [DecidableRel G.Adj] (π : Equiv.Perm (Fin 40))
    (hπ : ∀ v : Fin 40, blockOf blk7 (π v).val = blockOf blk7 v.val) (h : PRc7 G) :
    PRc7 (G.comap π.symm) := by
  have hp : ∀ v : Fin 40, bidx (π v).val = bidx v.val := fun v => by
    rw [← blockOf_blk7 _ (π v).2, ← blockOf_blk7 _ v.2, hπ]
  have hs : ∀ v : Fin 40, bidx (π.symm v).val = bidx v.val := fun v => by
    have := hp (π.symm v); simp only [Equiv.apply_symm_apply] at this; exact this.symm
  have hg : InGamma 9 π := by
    refine ⟨Fin.ext ?_, fun u => ?_⟩
    · have := bidx_spec (hp 0); simp at this; omega
    · have := bidx_spec (hp u); omega
  have h10 : π.symm 10 = 10 := Fin.ext (by have := bidx_spec (hs 10); simp at this; omega)
  have adj_of : ∀ a b : Fin 40, (8 ≤ a.val ∧ a.val ≤ 10) → (11 ≤ b.val ∧ b.val ≤ 12) →
      G.Adj a b := by
    intro a b ha hb
    have ha' : a = 8 ∨ a = 9 ∨ a = 10 := by omega
    have hb' : b = 11 ∨ b = 12 := by omega
    rcases ha' with rfl | rfl | rfl <;> rcases hb' with rfl | rfl <;>
      first | exact h.e1 | exact h.e2 | exact h.e3 | exact h.e4 | exact h.e5 | exact h.e6
  have unit : ∀ a b : Fin 40, (8 ≤ a.val ∧ a.val ≤ 10) → (11 ≤ b.val ∧ b.val ≤ 12) →
      (G.comap π.symm).Adj a b := by
    intro a b ha hb
    simp only [comap_adj]
    have sa := bidx_spec (hs a)
    have sb := bidx_spec (hs b)
    exact adj_of _ _ (by omega) (by omega)
  have hN : ∀ w : Fin 40, (G.comap π.symm).neighborFinset w =
      (G.neighborFinset (π.symm w)).map π.toEmbedding := fun w => by
    ext b
    simp only [mem_neighborFinset, comap_adj, mem_map_equiv]
  refine ⟨relabel_cliqueFree π h.tri, (relabel_indepNum π).trans h.alpha,
    relabel_cubeR h.tri hg h.cube, unit 10 11 (by simp) (by simp), unit 10 12 (by simp) (by simp),
    unit 8 11 (by simp) (by simp), unit 8 12 (by simp) (by simp), unit 9 11 (by simp) (by simp),
    unit 9 12 (by simp) (by simp), ?_, ?_, ?_⟩
  · intro i hi1 hi9
    simp only [comap_adj, h10]
    have si := bidx_spec (hs i)
    rw [h.pair _ (by omega) (by omega)]
    omega
  · intro u v huv
    rw [hN, hN, ← Finset.map_inter, card_map]
    exact h.codeg _ _ (fun e => huv (π.symm.injective e))
  · unfold blockEdges
    rw [← h.blockE]
    unfold blockEdges
    have h13 : ∀ x : Fin 40, 13 ≤ (π.symm x).val ↔ 13 ≤ x.val := fun x => (bidx_spec (hs x)).2.2.2.2.2
    refine card_bij (fun e _ => e.map π.symm) ?_ ?_ ?_
    · intro e he
      induction e using Sym2.ind with
      | _ a b =>
        simp only [mem_filter, mem_edgeFinset, mem_edgeSet, comap_adj, Sym2.map_mk,
          Sym2.mem_iff, forall_eq_or_imp, forall_eq] at he ⊢
        exact ⟨he.1, (h13 a).2 he.2.1, (h13 b).2 he.2.2⟩
    · intro e₁ _ e₂ _ heq
      exact Sym2.map.injective π.symm.injective heq
    · intro e he
      refine ⟨e.map π, ?_, by simp [Sym2.map_map]⟩
      induction e using Sym2.ind with
      | _ a b =>
        simp only [mem_filter, mem_edgeFinset, mem_edgeSet, comap_adj, Sym2.map_mk,
          Sym2.mem_iff, forall_eq_or_imp, forall_eq, Equiv.symm_apply_apply] at he ⊢
        exact ⟨he.1, (h13 (π a)).1 (by simpa using he.2.1), (h13 (π b)).1 (by simpa using he.2.2)⟩

/-- Lex-leader for the R(7) case: a model of `PRc7` gives a model of `PRc7` + every valid SB
clause whose witness maps each block of `1:7,2,1,2,27` onto itself (checked by `sbcheck` with
header `blocks=1:7,2,1,2,27`, soundness `Gen.checkGB_sound`). -/
theorem lexleader_rc7 (better : ℕ → ℕ → Prop) (hb : better = (· < ·) ∨ better = (· > ·))
    (val : AssignG 40 → ℕ) (SB : List (SBClauseG 40))
    (hblk : ∀ C ∈ SB, ∀ v : Fin 40, blockOf blk7 (C.wit v).val = blockOf blk7 v.val)
    (hP : ∀ C ∈ SB, SBValidG better val C) (G : SimpleGraph (Fin 40)) [DecidableRel G.Adj]
    (hG : PRc7 G) :
    ∃ x : AssignG 40, PRc7 (graphOfG x) ∧ ∀ C ∈ SB, (clause C.lits).sat (valId x) :=
  lexleader_inv PRc7 better hb val SB (fun C hC G _ h => prc7_inv G C.wit (hblk C hC) h) hP G hG

end R310.Rc7
